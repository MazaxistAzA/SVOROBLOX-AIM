local function checkKey()
    local key = KeyInput.Text
    if key == "SVOKAKTAK" then
        KeyCheck:Destroy()
        loadMainScript()
    else
        KeyInput.Text = ""
        KeyInput.PlaceholderText = "Wrong key!"
    end
end

