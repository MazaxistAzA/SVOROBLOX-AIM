-- Зашифрованный ключ
local function getVIPKey()
    local parts = {"VIP", "SVO", "MENU"}
    return table.concat(parts)
end

local function checkKey()
    local key = KeyInput.Text
    if key == "SVOKAKTAK" then
        KeyCheck:Destroy()
        loadMainScript(false)
    elseif key == getVIPKey() then
        KeyCheck:Destroy()
        loadMainScript(true)
    else
        KeyInput.Text = ""
        KeyInput.PlaceholderText = "Wrong key!"
    end
end

KeyButton.MouseButton1Click:Connect(checkKey)
KeyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        checkKey()
    end
end)

