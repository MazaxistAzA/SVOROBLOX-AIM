        aimCircle.Size = UDim2.new(0, AimSize * 2, 0, AimSize * 2)
        aimCircle.Position = UDim2.new(0.5, -AimSize, 0.5, -AimSize)
    end

    local function handleSliderInput(input)
        local mousePos = input.Position.X
        local sliderPos = SliderContainer.AbsolutePosition.X
        local sliderSize = SliderContainer.AbsoluteSize.X
        local percent = math.clamp((mousePos - sliderPos) / sliderSize, 0, 1)
        local value = math.floor(50 + percent * 250)
        updateSlider(value)
    end

