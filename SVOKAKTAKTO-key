                    if head then
                        head.CFrame = CFrame.new((Camera.CFrame + Camera.CFrame.LookVector * 5).Position)
                    end
                end
            end
        end
    end)

    task.spawn(function()
        while task.wait(0.05) do
            updateTargets()
            updateChams()
        end
    end)

    Players.LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        updateTargets()
    end)
end
