local function applyTheme(themeName)
    currentTheme = themeName
    local theme = themes[themeName]
    
    ToggleWindowBtn.BackgroundColor3 = theme.bg
    ToggleWindowBtn.TextColor3 = theme.text
    if themeName ~= "rgb" then
        toggleStroke.Color = theme.main
        mainStroke.Color = theme.main
        aimStroke.Color = theme.main
    end
    
    MainFrame.BackgroundColor3 = theme.bg
    
    Title.TextColor3 = theme.text
    
    aimCircle.BackgroundColor3 = theme.main
    
    for _, element in ipairs(allTextElements) do
        if element:IsA("TextLabel") or element:IsA("TextButton") or element:IsA("TextBox") then
            element.TextColor3 = theme.text
        end
    end
    
    for _, container in ipairs(allContainers) do
        if container:IsA("Frame") or container:IsA("TextButton") or container:IsA("TextBox") then
            container.BackgroundColor3 = theme.container
        end
    end
    
    if themeName ~= "rgb" then
        for _, stroke in ipairs(allStrokes) do
            if stroke ~= unloadStroke then
                stroke.Color = theme.main
            end
        end
    end
    
    -- Обновляем все открытые окна
    for _, frame in ipairs(activeFrames) do
        if frame and frame.Parent then
            local stroke = frame:FindFirstChildOfClass("UIStroke")
            if stroke then 
                if themeName == "rgb" then
                    stroke.Color = Color3.fromRGB(255, 0, 0)
                else
                    stroke.Color = theme.main
                end
            end
            for _, btn in ipairs(frame:GetDescendants()) do
                if btn:IsA("TextButton") then
                    local s = btn:FindFirstChildOfClass("UIStroke")
                    if s then 
                        if themeName == "rgb" then
                            s.Color = Color3.fromRGB(255, 0, 0)
                        else
                            s.Color = theme.main
                        end
                    end
                    if btn:IsA("TextButton") and btn.Parent == frame then
                        btn.TextColor3 = theme.text
                    end
                end
                if btn:IsA("TextLabel") then
                    btn.TextColor3 = theme.text
                end
                if btn:IsA("Frame") and btn ~= frame then
                    btn.BackgroundColor3 = theme.container
                end
            end
        end
    end
    
    if unloadStroke then
        if themeName == "red" then
            unloadStroke.Color = Color3.fromRGB(0, 100, 255)
        else
            unloadStroke.Color = Color3.fromRGB(255, 0, 0)
        end
    end
end

local function createToggle(text, y, key, callback)
    local container = Instance.new("Frame")
    container.Parent = ScrollingFrame
    container.Position = UDim2.new(0.05, 0, 0, y)
    container.Size = UDim2.new(0.9, 0, 0, 35)
    container.BackgroundColor3 = themes[currentTheme].container
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", container)
    stroke.Color = themes[currentTheme].main
    stroke.Thickness = 1
    table.insert(allContainers, container)
    table.insert(allStrokes, stroke)
    
    container.BackgroundTransparency = 1
    local appear = TweenService:Create(container, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0
    })
    appear:Play()
    
    local label = Instance.new("TextLabel")
    label.Parent = container
    label.Position = UDim2.new(0.05, 0, 0, 0)
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = themes[currentTheme].text
    label.Font = Enum.Font.Code
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    table.insert(allTextElements, label)
    
    local slider = Instance.new("TextButton")
    slider.Parent = container
    slider.Position = UDim2.new(0.65, 0, 0.15, 0)
    slider.Size = UDim2.new(0.3, 0, 0.7, 0)
    slider.BackgroundColor3 = states[key] and themes[currentTheme].main or Color3.fromRGB(60, 60, 60)
    slider.Text = states[key] and "ON" or "OFF"
    slider.TextColor3 = Color3.fromRGB(255, 255, 255)
    slider.Font = Enum.Font.Code
    slider.TextSize = 10
    Instance.new("UICorner", slider).CornerRadius = UDim.new(0, 6)
    table.insert(allTextElements, slider)
    
    slider.MouseButton1Click:Connect(function()
        states[key] = not states[key]
        local targetColor = states[key] and themes[currentTheme].main or Color3.fromRGB(60, 60, 60)
        local colorTween = TweenService:Create(slider, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = targetColor
        })
        colorTween:Play()
        slider.Text = states[key] and "ON" or "OFF"
        callback(states[key])
    end)
end

